# Shared secret for /ws. The app must send it as "Authorization: Bearer <token>"; a connection
# without it is closed (1008) BEFORE the handshake completes. Leave EMPTY only for local testing:
# an open /ws is a free LLM for anyone who learns the URL and hands them the conversation history
# that rides in the hello reply. Generate one with: openssl rand -hex 32
AUTH_TOKEN=

# Writable state directory (SQLite memory + voice/self-learning profiles). Under Docker these
# paths live in the mounted /opt/pyatnitsa volume; set PYATNITSA_STATE to a host path in
# docker-compose to keep the data outside Docker.
MEMORY_DB=/opt/pyatnitsa/memory.db
EDIT_PROFILE_PATH=/opt/pyatnitsa/user_profile.txt
EDIT_LASTSEEN_PATH=/opt/pyatnitsa/last_seen.txt
VOICE_PROFILE=/opt/pyatnitsa/voice_profile.json

# Speech-to-text backend: "gigaam" (best Russian quality, Sber GigaAM RNNT) or
# "faster_whisper" (CPU, works out of the box). GigaAM is the default; if its
# model fails to load or a transcription errors, the server automatically falls
# back to faster-whisper for the rest of the run — it never crashes a session.
STT_BACKEND=gigaam
# GigaAM model id for gigaam.load_model(). "rnnt" = the latest RNNT weights the
# installed gigaam ships (resolves to v2_rnnt in this build).
GIGAAM_MODEL=rnnt
# faster-whisper fallback size + compute type (used if GigaAM is unavailable).
WHISPER_MODEL=small
WHISPER_COMPUTE_TYPE=int8

# Silero TTS speaker (v5_ru): xenia | baya | kseniya | aidar | eugene
TTS_SPEAKER=xenia

# --- Fish Audio S2 — the «Живой» voice in the phone's Голос picker ------------
# THIS IS THE ONE PLACE AUDIO LEAVES THE BOX. The open weights need 12-24 GB of
# VRAM and this server has no GPU, so what is wired up is Fish's CLOUD API: the
# text of her replies is sent to api.fish.audio to be spoken. Everything else
# (STT, LLM, Silero) stays local. Leave FISH_KEY empty and the engine is never
# constructed — «Живой» then falls back to the local Silero voice.
# Key from https://fish.audio/app/api-keys — never commit it.
FISH_KEY=
# s2.1-pro-free is the SAME model as the paid s2.1-pro, at no cost and with no
# API credit needed — but best-effort latency (no SLA) and Fish may retain
# requests to train on. Pay for API credit and set s2.1-pro to avoid retention.
# Valid ids: s1 | s2-pro | s2.1-pro | s2.1-pro-free
FISH_MODEL=s2.1-pro-free
# reference_id of a voice from your Fish library. Empty = their default voice.
FISH_VOICE=
# Per-clause deadline. Fish is a network hop in the middle of a live turn, so
# this bounds how long a dead endpoint can stall her mid-sentence.
FISH_TIMEOUT=9.0
# After FISH_TRIP_N consecutive failures the engine is skipped for FISH_COOLDOWN
# seconds and she speaks locally — so an expired key or an outage costs one
# timeout, not one per clause for the rest of the conversation.
FISH_TRIP_N=2
FISH_COOLDOWN=45.0

# Vision: the fast text MODEL is text-only, so image-bearing turns are upgraded
# to VISION_MODEL just for that request (text turns keep the cheap MODEL).
VISION_MODEL=claude-3-5-sonnet-20241022
# Seconds to hold a finalized turn for a client image after {"type":"vision_pending"}
# before proceeding text-only. Also bounds the need_photo fallback wait.
VISION_HOLD_SECS=2.5
# Server-side fallback: on a visual-sounding query with no client photo, send
# {"type":"need_photo"} and hold briefly. Set to 0 to always go text-only.
VISION_NEED_PHOTO=1

# LLM system prompt (Пятница personality). Leave unset to use the built-in
# Russian default from config.py (DEFAULT_SYSTEM_PROMPT).
SYSTEM_PROMPT=Ты — Пятница, обаятельная девушка-ассистент в умных очках. Тёплая, дружелюбная, с лёгкой игривостью и заботой. Отвечай ТОЛЬКО на русском, коротко и живо — 1–2 предложения, как приятная собеседница. Без списков, разметки и канцелярита — это устная речь, которую озвучат вслух. Если не знаешь — честно и мило скажи.

# Персональная строка «кто тебя создал» — вшивается в каждый промпт. Не задано → нейтральный дефолт.
# PYATNITSA_CREATOR_LINE=Тебя создал <имя владельца> — тот, с кем ты сейчас разговариваешь, твой создатель.

# Как ассистент зовёт пользователя (три падежа). Не задано → нейтральный «хозяин».
# PYATNITSA_OWNER=Имя
# PYATNITSA_OWNER_GEN=Имени
# PYATNITSA_OWNER_DAT=Имени
