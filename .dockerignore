# Never bake secrets or host-local state into the image (`COPY . .` takes everything else).
# The real .env is mounted at runtime instead (docker-compose `env_file:`).
.env
.env.*
!.env.example

# Host virtualenv / bytecode — wrong platform inside the image, and huge.
.venv/
__pycache__/
*.pyc
*.pyo

# Model + runtime state live in named volumes, not in the image.
model-cache/
state/
*.db
*.db-journal
*.db-wal
voice_profile.json
user_profile.txt
last_seen.txt

.git/
.gitignore
